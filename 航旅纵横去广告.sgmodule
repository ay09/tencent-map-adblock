#!name=航旅纵横去广告
#!desc=只拦开屏（sns/1000019）与 OSS advert；不拦首页探索。单文件模块。
#!system=ios
#!category=去广告
#!requirement=CORE_VERSION>=20

[Rule]
DOMAIN,analytics.umetrip.com,REJECT
DOMAIN,sensors.umetrip.com.cn,REJECT
DOMAIN,bda.umetrip.com,REJECT

[URL Rewrite]
^https?:\/\/(?:discardrp|startup)\.umetrip\.com\/gateway\/api\/umetrip\/native(?:\?.*)?$ - reject
^https:\/\/oss\.umetrip\.com\/fs\/advert\/ - reject

[Script]
航旅纵横-开屏 = type=http-request, pattern=^https?:\/\/sns\.umetrip\.com\/gateway\/api\/umetrip\/native(?:\?.*)?$, script-path=https://raw.githubusercontent.com/ay09/tencent-map-adblock/main/umetrip_ads.js, requires-body=false, timeout=10, script-update-interval=86400

[MITM]
hostname = %APPEND% sns.umetrip.com, discardrp.umetrip.com, startup.umetrip.com, oss.umetrip.com
